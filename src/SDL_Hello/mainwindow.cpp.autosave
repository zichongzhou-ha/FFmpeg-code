#include<QDebug>
#include "mainwindow.h"
#include "ui_mainwindow.h"
#include "playthread.h"

MainWindow::MainWindow(QWidget *parent)
    : QMainWindow(parent)
    , ui(new Ui::MainWindow)
    , _playthread(nullptr)
{
    ui->setupUi(this);
}

MainWindow::~MainWindow()
{
    delete ui;
}
void show_Version()
{
    SDL_version version;
    SDL_VERSION(&version);
    qDebug()<<version.major<<version.minor<<version.patch;
}

void MainWindow::on_pushButton_clicked()
{
    if(_playthread)
    {
        _playthread->requestInterruption();
        _playthread=nullptr;
        ui->pushButton->setText(u8"开始播放");
    }
    else
    {
        _playthread=new PlayThread(this);
        _playthread->start();
        connect(_playthread,&PlayThread::finished,
                [this](){
            _playthread=nullptr;
            ui->pushButton->setText(u8"开始播放");
            //写这个是为了说如果线程结束了，那这个按钮也要变
        });
        
        ui->pushButton->setText(u8"停止播放");
    }

}
